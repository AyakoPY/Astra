# ============ ASTRA — configuración ============
# Copia este archivo como ".env" (sin ".example") y cambia solo lo que necesites.
# Las líneas que empiezan con # están desactivadas. Quita el # para activarlas.

# --- OBLIGATORIO ---
# Clave gratis en https://aistudio.google.com/apikey
# La clave de Gemini ya NO hace falta ponerla aqui: Astra la pide al abrir (menu ... > Clave de Gemini). Solo si quieres fijarla desde este archivo:
GEMINI_API_KEY=

# --- Voz y modelos (casi nunca hace falta tocarlos) ---
GEMINI_VOICE=Aoede
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# El modelo de chat se elige solo (el más rápido de tu cuenta). Solo para forzar uno:
# GEMINI_CHAT_MODEL=gemini-3.5-flash
# GEMINI_CHAT_LOCK=1
# Modelo extra por si el principal falla:
# GEMINI_FALLBACK_MODEL=gemini-flash-latest

# --- Tu zona y ciudad ---
TIMEZONE=America/Asuncion
# Ciudad por defecto del clima (si no, usa la de tu perfil)
# DEFAULT_CITY=Asunción

# --- Escucha de "Astra" ---
# Seguridad mínima del reconocedor de Windows (0.1 a 1). Sube (0.6-0.7) si se activa sola con ruido o teclado; baja (0.4) si no te oye. Decir solo «Astra» pide +0.05.
WAKE_CONFIDENCE=0.5

# --- Volumen mientras ella habla ---
# Apps cuyo volumen baja mientras Astra habla (separadas por coma). Pon none para desactivarlo.
DUCK_APPS=brave,chrome,firefox,opera,vivaldi,spotify
# Nivel al que baja (0-100)
DUCK_LEVEL=15

# --- Avanzado ---
PORT=3000
# Si Gemini Live rechaza la detección automática de voz, pon 0
# GEMINI_VAD=0
# Búsqueda con Google solo existe en el plan de pago de Gemini; con plan de pago pon 1
# USE_GROUNDING=0
# Rutas, si no las encuentra solo:
# BRAVE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
# STEAM_PATH=C:\Program Files (x86)\Steam   (la carpeta de Steam, no el .exe)
# Carpeta de notas/memoria. Si ya usabas VAULT_PATH=./vault, DÉJALO IGUAL para no perder tu memoria.
# Si lo quitas, usa %APPDATA%\JARVIS\vault.
VAULT_PATH=./vault

# --- Gmail (leer y resumir correos, solo lectura) ---
# 1) Activa la verificación en 2 pasos en tu cuenta de Google
# 2) Crea una «contraseña de aplicación»: https://myaccount.google.com/apppasswords
# 3) En Gmail > Configuración > Reenvío y POP/IMAP: activa IMAP
GMAIL_USER=
GMAIL_APP_PASSWORD=
